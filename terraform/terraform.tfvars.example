# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars to version control.

aws_region   = "us-east-1"
project_name = "securestay"
environment  = "dev"

# ─── EC2 ──────────────────────────────────────────────────────────────────────

instance_type = "t2.micro" # Free Tier eligible

# Name of an existing EC2 key pair in your AWS account (optional).
# Leave empty to use SSM Session Manager for access (no key needed).
key_name = ""

# Your GitHub repository URL.
repo_url    = "https://github.com/nimeshayasith/SecureStay.git"
repo_branch = "kaveesha"

# GitHub Personal Access Token — required for private repos.
# Create at: GitHub → Settings → Developer settings → Personal access tokens
# → Fine-grained → Repository: SecureStay → Contents: Read-only
github_token = "github_pat_XXXX"

# Restrict SSH to your own IP for security: e.g. "203.0.113.10/32"
allowed_ssh_cidr = "0.0.0.0/0"

# ─── RDS ──────────────────────────────────────────────────────────────────────

db_instance_class    = "db.t3.micro" # Free Tier eligible
db_name              = "securestay"
db_username          = "securestay"
db_password          = "CHANGE_ME_strong_password_123!" # min 8 chars
db_allocated_storage = 20 # Free Tier max is 20 GB

# ─── Application ──────────────────────────────────────────────────────────────

jwt_secret = "CHANGE_ME_use_a_long_random_string_here"
